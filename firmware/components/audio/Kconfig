menu "aibot audio"

    config AIBOT_I2S_BCLK_GPIO
        int "MAX98357A BCLK GPIO"
        default 4

    config AIBOT_I2S_LRC_GPIO
        int "MAX98357A LRC (word select) GPIO"
        default 5

    config AIBOT_I2S_DIN_GPIO
        int "MAX98357A DIN GPIO"
        default 6

    config AIBOT_AUDIO_VOLUME
        int "Volume at boot (%)"
        range 0 100
        default 50

    config AIBOT_MIC_SCK_GPIO
        int "INMP441 SCK (bit clock) GPIO"
        default 15

    config AIBOT_MIC_WS_GPIO
        int "INMP441 WS (word select) GPIO"
        default 16

    config AIBOT_MIC_SD_GPIO
        int "INMP441 SD (data) GPIO"
        default 17

    config AIBOT_MIC_GAIN_DB
        int "Microphone gain at boot (dB)"
        range 0 40
        default 18

endmenu
